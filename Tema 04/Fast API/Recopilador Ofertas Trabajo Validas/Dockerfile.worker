# ============================================================================
# Telegram Worker - Minimal container for processing message queue
# ============================================================================
FROM python:3.12-slim

WORKDIR /app

# Install only runtime dependencies (no LaTeX needed)
RUN apt-get update && apt-get install -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY src/ src/
COPY telegram_worker.py .

# Health check (optional, for Render monitoring)
HEALTHCHECK --interval=60s --timeout=10s --retries=3 \
    CMD ps aux | grep telegram_worker.py || exit 1

# Run worker
CMD ["python", "telegram_worker.py"]
