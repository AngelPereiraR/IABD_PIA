# ============================================================
# PLAN 00: INFRAESTRUCTURA BASE - Variables de Entorno
# ============================================================

# --- BASE DE DATOS (Neon PostgreSQL) ---
# Formato: postgresql://user:password@host/dbname
DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-1.neon.tech/opticv"

# --- CLOUDINARY (Storage de archivos) ---
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# --- IA Y MODELOS ---
DEEPSEEK_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- SCRAPING Y CONTENIDO ---
JINA_API_KEY="jina_xxxxxxxxxxxxxxxxxxxxxxxxxx"
FIRECRAWL_API_KEY="fc_xxxxxxxxxxxxxxxxxxxxxxxx"

# --- TELEGRAM (Notificaciones) ---
TELEGRAM_BOT_TOKEN="123456789:ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefgh"
TELEGRAM_CHAT_ID="987654321"

# --- GOOGLE (Gmail) ---
# Contenido completo de credentials.json (desde Google Cloud Console)
GOOGLE_CREDENTIALS_JSON='{"type":"service_account","project_id":"..."}'

# Contenido de token.json (generado por setup_auth.py)
GOOGLE_TOKEN_JSON='{"access_token":"","token_type":"Bearer",...}'

# --- SERVIDOR (FastAPI) ---
# Puerto por defecto: 7861 (devcontainer), 7860 (HF Spaces), 10000 (Render)
PORT=7861

# --- USER_ID (para multi-usuario en futuro) ---
# UUID del usuario único (opcional)
USER_ID="123e4567-e89b-12d3-a456-426614174000"
USER_EMAIL="your-email@example.com"
USER_PASSWORD="your_secure_password"